# Clerk — publishable key, sama seperti NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY di
# dashboard (satu instance Clerk yang sama dipakai web & mobile). Ambil dari
# dashboard.clerk.com > API Keys. Aman untuk di-bundle ke app (bukan secret key).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_Y2xlYW4tZ2Vja28tNTIuY2xlcmsuYWNjb3VudHMuZGV2JA"

# Base URL dashboard Next.js (yang punya /api/*). Emulator Android tidak bisa
# akses "localhost" milik komputer host — pakai 10.0.2.2, atau IP LAN komputer
# kalau test di HP fisik lewat Expo Go/dev client.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# JSON statis { "latestVersion": "1.2.0", "apkUrl": "https://...", "notes": "..." }
# dipakai untuk cek update APK manual (perubahan native/SDK yang tidak bisa
# dikirim lewat EAS Update). Host di GitHub raw / Firebase Hosting / dst.
EXPO_PUBLIC_VERSION_CHECK_URL="https://raw.githubusercontent.com/<org>/<repo>/main/version.json"
